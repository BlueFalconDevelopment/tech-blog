---
import { AUTHOR, SITE_TITLE } from "../consts";

const year = new Date().getFullYear();
---

<footer class="border-t border-slate-200 dark:border-slate-800">
  <div
    class="mx-auto flex max-w-3xl flex-col items-center gap-2 px-4 py-8 text-sm text-slate-500 sm:flex-row sm:justify-between sm:px-6 dark:text-slate-400"
  >
    <p>&copy; {year} {AUTHOR}. {SITE_TITLE}.</p>
    <a href="/rss.xml" class="hover:text-slate-800 dark:hover:text-slate-200">
      RSS feed
    </a>
  </div>
</footer>
