---
import { AUTHOR, SITE_TITLE } from "../consts";

const year = new Date().getFullYear();
---

<footer class="border-t border-term-border">
  <div
    class="mx-auto flex max-w-3xl flex-col items-center gap-2 px-4 py-8 text-sm text-term-fg-dim sm:flex-row sm:justify-between sm:px-6"
  >
    <p>&copy; {year} {AUTHOR}. {SITE_TITLE}.</p>
    <a href="/rss.xml" class="hover:text-term-fg-bright"> RSS feed </a>
  </div>
</footer>
