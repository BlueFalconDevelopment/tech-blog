---
import { NAV_LINKS, SITE_TITLE } from "../consts";

const { pathname } = Astro.url;
---

<header class="border-b border-term-border bg-term-bg/90 backdrop-blur">
  <div
    class="mx-auto flex max-w-3xl items-center justify-between px-4 py-4 sm:px-6"
  >
    <a
      href="/"
      class="text-lg font-semibold tracking-tight text-term-fg-bright"
    >
      {SITE_TITLE}<span class="cursor-blink" aria-hidden="true">_</span>
    </a>
    <nav class="flex items-center gap-1 sm:gap-2">
      {
        NAV_LINKS.map((link) => {
          const active =
            link.href === "/"
              ? pathname === "/"
              : pathname.startsWith(link.href);
          return (
            <a
              href={link.href}
              aria-current={active ? "page" : undefined}
              class:list={[
                "rounded-none px-2 py-1.5 text-sm font-medium transition sm:px-3",
                active
                  ? "text-term-fg-bright underline underline-offset-4"
                  : "text-term-fg-dim hover:text-term-fg-bright",
              ]}
            >
              {link.label}
            </a>
          );
        })
      }
    </nav>
  </div>
</header>
