---
import { NAV_LINKS, SITE_TITLE } from "../consts";
import ThemeToggle from "./ThemeToggle.astro";

const { pathname } = Astro.url;
---

<header
  class="border-b border-slate-200 bg-white/80 backdrop-blur dark:border-slate-800 dark:bg-slate-900/80"
>
  <div
    class="mx-auto flex max-w-3xl items-center justify-between px-4 py-4 sm:px-6"
  >
    <a
      href="/"
      class="text-lg font-semibold tracking-tight text-slate-900 dark:text-white"
    >
      {SITE_TITLE}
    </a>
    <nav class="flex items-center gap-1 sm:gap-2">
      {
        NAV_LINKS.map((link) => {
          const active =
            link.href === "/"
              ? pathname === "/"
              : pathname.startsWith(link.href);
          return (
            <a
              href={link.href}
              aria-current={active ? "page" : undefined}
              class:list={[
                "rounded-md px-2 py-1.5 text-sm font-medium transition sm:px-3",
                active
                  ? "text-sky-600 dark:text-sky-400"
                  : "text-slate-600 hover:text-slate-900 dark:text-slate-300 dark:hover:text-white",
              ]}
            >
              {link.label}
            </a>
          );
        })
      }
      <ThemeToggle />
    </nav>
  </div>
</header>
