---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Search" description="Search the blog.">
  <h1
    class="mb-6 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl dark:text-white"
  >
    Search
  </h1>

  <div id="search"></div>

  <p class="mt-6 text-sm text-slate-500 dark:text-slate-400">
    Search only works in production builds (<code>npm run build</code> then <code
      >npm run preview</code
    >) &mdash; the Pagefind index doesn't exist yet in <code>npm run dev</code>.
  </p>
</BaseLayout>

<link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
<script is:inline src="/pagefind/pagefind-ui.js"></script>
<script is:inline>
  window.addEventListener("DOMContentLoaded", () => {
    if (typeof PagefindUI === "undefined") return;
    new PagefindUI({ element: "#search", showSubResults: true });
  });
</script>
