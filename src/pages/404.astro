---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found">
  <div class="py-16 text-center">
    <p class="text-sm font-semibold text-term-fg-bright">404</p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight text-term-fg-bright sm:text-4xl">
      Page not found
    </h1>
    <p class="mt-4 text-term-fg-dim">
      The page you're looking for doesn't exist.
    </p>
    <a href="/" class="mt-6 inline-block font-medium text-term-fg-bright hover:underline">
      &larr; Back home
    </a>
  </div>
</BaseLayout>
