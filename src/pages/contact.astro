---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Contact" description="Get in touch.">
  <h1 class="mb-6 text-3xl font-bold tracking-tight text-term-fg-bright sm:text-4xl">
    Contact
  </h1>
  <p class="mb-8 text-term-fg-dim">
    This form is handled by Netlify Forms &mdash; no backend required. Submissions
    show up in your Netlify site dashboard under Forms.
  </p>

  <form
    name="contact"
    method="POST"
    data-netlify="true"
    netlify-honeypot="bot-field"
    class="flex flex-col gap-4"
  >
    <input type="hidden" name="form-name" value="contact" />
    <p class="hidden">
      <label>
        Don't fill this out if you're human: <input name="bot-field" />
      </label>
    </p>

    <div class="flex flex-col gap-1">
      <label for="name" class="text-sm font-medium text-term-fg">
        Name
      </label>
      <input
        id="name"
        name="name"
        type="text"
        required
        class="rounded-none border border-term-border bg-term-panel px-3 py-2 text-sm text-term-fg focus:border-term-fg-bright focus:outline-none"
      />
    </div>

    <div class="flex flex-col gap-1">
      <label for="email" class="text-sm font-medium text-term-fg">
        Email
      </label>
      <input
        id="email"
        name="email"
        type="email"
        required
        class="rounded-none border border-term-border bg-term-panel px-3 py-2 text-sm text-term-fg focus:border-term-fg-bright focus:outline-none"
      />
    </div>

    <div class="flex flex-col gap-1">
      <label for="message" class="text-sm font-medium text-term-fg">
        Message
      </label>
      <textarea
        id="message"
        name="message"
        rows="5"
        required
        class="rounded-none border border-term-border bg-term-panel px-3 py-2 text-sm text-term-fg focus:border-term-fg-bright focus:outline-none"
      ></textarea>
    </div>

    <button
      type="submit"
      class="mt-2 w-fit rounded-none border border-term-fg bg-term-fg px-4 py-2 text-sm font-medium text-term-bg transition hover:bg-term-fg-bright hover:border-term-fg-bright"
    >
      [ Send message ]
    </button>
  </form>
</BaseLayout>
