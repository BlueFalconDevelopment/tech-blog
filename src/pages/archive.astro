---
import BaseLayout from "../layouts/BaseLayout.astro";
import sidebarHtml from "../data/archive/sidebar.html?raw";
import sectionsHtml from "../data/archive/sections.html?raw";
---

<BaseLayout
  title="Archive"
  description="A searchable field reference: Kali, Ubuntu, Bash, Docker, Git, Python, Blender, Minecraft admin, and more, all in one amber-terminal lookup."
  fullBleed
>
  <div class="mb-6">
    <h1
      class="text-3xl font-bold tracking-tight text-term-fg-bright sm:text-4xl"
    >
      Archive<span class="cursor-blink" aria-hidden="true">_</span>
    </h1>
    <p class="mt-2 text-term-fg-dim">
      Sixteen field-reference cheat sheets, one search box. Press <kbd
        class="border border-term-border bg-term-panel px-1.5 py-0.5 text-xs"
        >/</kbd
      > to search, <kbd
        class="border border-term-border bg-term-panel px-1.5 py-0.5 text-xs"
        >Esc</kbd
      > to clear.
    </p>
  </div>

  <div
    class="sticky top-0 z-10 -mx-4 mb-6 flex flex-wrap items-center gap-3 border-y border-term-border bg-term-bg/95 px-4 py-3 backdrop-blur sm:-mx-6 sm:px-6"
  >
    <label
      for="archive-search"
      class="whitespace-nowrap text-sm text-term-fg-dim"
      >root@archive:~$ grep -i</label
    >
    <span class="relative flex min-w-[10rem] flex-1 items-center">
      <input
        id="archive-search"
        type="text"
        autocomplete="off"
        spellcheck="false"
        placeholder="search all cheat sheets..."
        aria-label="Search all cheat sheets"
        class="w-full border-none bg-transparent text-sm text-term-fg-bright placeholder:text-term-border-strong focus:outline-none"
      />
      <span
        id="archive-cursor"
        class="cursor-blink ml-0.5 text-term-fg"
        aria-hidden="true">&#9608;</span
      >
    </span>
    <button
      id="archive-clear"
      type="button"
      class="border border-term-border px-3 py-1 text-xs text-term-fg-dim transition hover:border-term-fg-dim hover:text-term-fg-bright"
    >
      CLEAR
    </button>
    <span
      id="archive-matchcount"
      class="min-w-[10ch] text-right text-xs text-term-fg-dim"
      aria-live="polite"></span>
  </div>

  <div class="grid grid-cols-1 gap-8 md:grid-cols-[220px_1fr]">
    <nav
      aria-label="Subjects"
      class="aa-sidebar overflow-y-auto pb-8 md:sticky md:top-20 md:max-h-[calc(100vh-6rem)] md:self-start"
      set:html={sidebarHtml}
    />
    <div id="archive-content">
      <Fragment set:html={sectionsHtml} />
      <div id="archive-empty" class="hidden py-8 text-sm text-term-fg-dim">
        No matches. Try a different term, or press ESC to clear.
      </div>
    </div>
  </div>
</BaseLayout>

<style is:global>
  /* Amber Archive fragment styling. These classes come from raw HTML
     injected via set:html (generated by build_archive.py from the cheat
     sheet .txt files), so Astro's scoped-style attribute never reaches
     them -- this block has to be global rather than scoped. */

  .dirgroup {
    margin-bottom: 1.1rem;
  }
  .dirlabel {
    color: var(--color-term-fg-dim);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    padding: 0.2rem 0.3rem 0.4rem;
    border-bottom: 1px solid var(--color-term-border);
    margin-bottom: 0.25rem;
  }
  .navitem {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    width: 100%;
    background: none;
    border: none;
    color: var(--color-term-fg-dim);
    font: inherit;
    font-size: 0.83rem;
    text-align: left;
    padding: 0.32rem 0.3rem;
    cursor: pointer;
  }
  .navitem .tree {
    color: var(--color-term-border-strong);
    flex: 0 0 auto;
  }
  .navitem .navlabel {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .navitem .navnum {
    color: var(--color-term-border-strong);
    font-size: 0.7rem;
    flex: 0 0 auto;
  }
  .navitem:hover {
    color: var(--color-term-fg-bright);
    background: var(--color-term-panel-hover);
  }
  .navitem.active {
    color: var(--color-term-fg-bright);
    background: var(--color-term-panel);
  }
  .navitem.active .tree {
    color: var(--color-term-fg);
  }

  .filesec {
    padding-bottom: 1.75rem;
    margin-bottom: 2.25rem;
    border-bottom: 1px solid var(--color-term-border);
    scroll-margin-top: 5.5rem;
  }
  .filesec:last-child {
    border-bottom: none;
  }
  .filehead {
    display: flex;
    align-items: baseline;
    gap: 0.85rem;
    margin-bottom: 0.9rem;
    flex-wrap: wrap;
  }
  .filehead .tag {
    color: var(--color-term-fg-dim);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
  }
  .filehead h2 {
    font-size: 1.6rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--color-term-fg-bright);
    margin: 0;
  }
  .filebody {
    max-width: 68ch;
  }

  .subhead {
    color: var(--color-term-fg-bright);
    font-size: 0.92rem;
    letter-spacing: 0.03em;
    margin: 1.5rem 0 0.5rem;
    padding-bottom: 0.25rem;
    border-bottom: 1px dashed var(--color-term-border);
  }
  .subhead:first-child {
    margin-top: 0;
  }

  .bullet {
    display: flex;
    gap: 0.55rem;
    align-items: baseline;
    padding: 0.16rem 0;
  }
  .bullet .mark {
    color: var(--color-term-fg);
    flex: 0 0 auto;
    font-size: 0.78rem;
  }
  .bullet .cmd {
    color: var(--color-term-fg-bright);
  }
  .bullet .sep,
  .bullet .desc {
    color: var(--color-term-fg-dim);
  }
  .bullet .btext {
    color: var(--color-term-fg);
  }

  .plain {
    color: var(--color-term-fg-dim);
    white-space: pre-wrap;
    line-height: 1.6;
    padding: 0.12rem 0;
  }
  .blank {
    height: 0.6rem;
  }

  .code-wrap {
    overflow-x: auto;
    margin: 0.6rem 0 1.1rem;
    border-left: 2px solid var(--color-term-border);
    padding: 0.15rem 0 0.15rem 0.8rem;
  }
  .code {
    white-space: pre;
    color: var(--color-term-fg);
    font-size: 0.82rem;
    line-height: 1.55;
    margin: 0;
  }

  mark.hit {
    background: var(--color-term-fg-bright);
    color: var(--color-term-bg);
    padding: 0 1px;
  }

  .is-hidden {
    display: none !important;
  }
</style>

<script>
  const search = document.getElementById("archive-search") as HTMLInputElement;
  const clearBtn = document.getElementById("archive-clear") as HTMLButtonElement;
  const matchcount = document.getElementById("archive-matchcount") as HTMLElement;
  const emptyState = document.getElementById("archive-empty") as HTMLElement;
  const navitems = Array.from(document.querySelectorAll<HTMLButtonElement>(".navitem"));
  const filesecs = Array.from(document.querySelectorAll<HTMLElement>(".filesec"));
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  function clearHighlights(el: Element) {
    const marks = el.querySelectorAll("mark.hit");
    marks.forEach((m) => {
      const parent = m.parentNode;
      if (!parent) return;
      parent.replaceChild(document.createTextNode(m.textContent || ""), m);
      parent.normalize();
    });
  }

  function highlight(el: Element, q: string) {
    const walker = document.createTreeWalker(el, NodeFilter.SHOW_TEXT, null);
    const textNodes: Text[] = [];
    let n: Node | null;
    while ((n = walker.nextNode())) textNodes.push(n as Text);
    const lowerQ = q.toLowerCase();
    textNodes.forEach((node) => {
      const text = node.nodeValue || "";
      const lower = text.toLowerCase();
      let idx = lower.indexOf(lowerQ);
      if (idx === -1) return;
      const frag = document.createDocumentFragment();
      let last = 0;
      while (idx !== -1) {
        if (idx > last) frag.appendChild(document.createTextNode(text.slice(last, idx)));
        const mark = document.createElement("mark");
        mark.className = "hit";
        mark.textContent = text.slice(idx, idx + q.length);
        frag.appendChild(mark);
        last = idx + q.length;
        idx = lower.indexOf(lowerQ, last);
      }
      if (last < text.length) frag.appendChild(document.createTextNode(text.slice(last)));
      node.parentNode?.replaceChild(frag, node);
    });
  }

  function runSearch() {
    const q = search.value.trim();
    if (!q) {
      filesecs.forEach((sec) => {
        sec.classList.remove("is-hidden");
        sec.querySelectorAll(".filebody > *").forEach((b) => {
          b.classList.remove("is-hidden");
          clearHighlights(b);
        });
      });
      matchcount.textContent = "";
      emptyState.classList.add("hidden");
      return;
    }
    const lowerQ = q.toLowerCase();
    let totalMatches = 0;
    let fileMatches = 0;
    filesecs.forEach((sec) => {
      const blocks = Array.from(sec.querySelectorAll(".filebody > *"));
      let hasMatch = false;
      blocks.forEach((b) => {
        clearHighlights(b);
        if (b.classList.contains("blank")) {
          b.classList.add("is-hidden");
          return;
        }
        const text = (b.textContent || "").toLowerCase();
        const idx = text.indexOf(lowerQ);
        if (idx !== -1) {
          b.classList.remove("is-hidden");
          highlight(b, q);
          hasMatch = true;
          let c = 0;
          let p = idx;
          while (p !== -1) {
            c++;
            p = text.indexOf(lowerQ, p + lowerQ.length);
          }
          totalMatches += c;
        } else {
          b.classList.add("is-hidden");
        }
      });
      if (hasMatch) {
        sec.classList.remove("is-hidden");
        fileMatches++;
      } else {
        sec.classList.add("is-hidden");
      }
    });
    matchcount.textContent = `${totalMatches} ${totalMatches === 1 ? "match" : "matches"} in ${fileMatches} ${fileMatches === 1 ? "file" : "files"}`;
    emptyState.classList.toggle("hidden", totalMatches !== 0);
  }

  let debounceT: ReturnType<typeof setTimeout>;
  search.addEventListener("input", () => {
    clearTimeout(debounceT);
    debounceT = setTimeout(runSearch, 60);
  });

  clearBtn.addEventListener("click", () => {
    search.value = "";
    runSearch();
    search.focus();
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "/" && document.activeElement !== search) {
      e.preventDefault();
      search.focus();
    } else if (e.key === "Escape" && document.activeElement === search) {
      search.value = "";
      runSearch();
      search.blur();
    }
  });

  navitems.forEach((btn) => {
    btn.addEventListener("click", () => {
      const targetId = btn.getAttribute("data-target");
      const target = targetId ? document.getElementById(targetId) : null;
      if (target) {
        target.scrollIntoView({ behavior: reduceMotion ? "auto" : "smooth", block: "start" });
        navitems.forEach((b) => b.classList.remove("active"));
        btn.classList.add("active");
      }
    });
  });

  const navMap = new Map<string, HTMLButtonElement>();
  navitems.forEach((b) => {
    const t = b.getAttribute("data-target");
    if (t) navMap.set(t, b);
  });
  if ("IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const btn = navMap.get(entry.target.id);
            if (btn) {
              navitems.forEach((b) => b.classList.remove("active"));
              btn.classList.add("active");
            }
          }
        });
      },
      { rootMargin: "-10% 0px -70% 0px", threshold: 0 },
    );
    filesecs.forEach((f) => observer.observe(f));
  }
</script>
